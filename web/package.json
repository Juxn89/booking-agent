{
  "name": "booking-agent-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3020",
    "dev:aspire": "next dev",
    "build": "next build",
    "start": "next start --port 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
